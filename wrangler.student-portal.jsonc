{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "student-portal",
  "main": "workers/student-portal/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "limits": { "cpu_ms": 10000 },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "triggers": { "crons": [] },
  "durable_objects": {
    "bindings": [{ "name": "PORTAL_LIVE", "class_name": "PortalLiveUpdatesV1" }]
  },
  "migrations": [{ "tag": "live-v1", "new_sqlite_classes": ["PortalLiveUpdatesV1"] }],
  "vars": {
    "PORTAL_ENVIRONMENT": "local",
    "PORTAL_ORIGIN": "http://localhost:8787",
    "PORTAL_ADMIN_TENANT_ID": "f04e0fa3-b8dc-4f77-be3c-7dfda0635188"
  },
  "env": {
    "preview": {
      "vars": {
        "PORTAL_ENVIRONMENT": "preview",
        "PORTAL_ORIGIN": "https://student-portal-preview.invalid",
        "PORTAL_ADMIN_TENANT_ID": "f04e0fa3-b8dc-4f77-be3c-7dfda0635188"
      },
      "services": [],
      "hyperdrive": [],
      "durable_objects": {
        "bindings": [{ "name": "PORTAL_LIVE", "class_name": "PortalLiveUpdatesV1" }]
      },
      "triggers": { "crons": [] }
    },
    "production": {
      "name": "student-portal-production",
      "vars": {
        "PORTAL_ENVIRONMENT": "production",
        "PORTAL_SERVING_ENABLED": "true",
        "PORTAL_PHOTOS_ENABLED": "true",
        "PORTAL_PUBLICATION_MODE": "scoped-v2",
        "PORTAL_ORIGIN": "https://aluno.escolaieda.com",
        "PORTAL_ADMIN_TENANT_ID": "f04e0fa3-b8dc-4f77-be3c-7dfda0635188"
      },
      "services": [],
      "hyperdrive": [{ "binding": "PORTAL_DB", "id": "46ac2fcb25ad4ad5b5662d536ccd968a" }],
      "durable_objects": {
        "bindings": [{ "name": "PORTAL_LIVE", "class_name": "PortalLiveUpdatesV1" }]
      },
      "ratelimits": [
        { "name": "PORTAL_AUTH_GLOBAL", "namespace_id": "100715", "simple": { "limit": 600, "period": 60 } },
        { "name": "PORTAL_AUTH_SUBJECT", "namespace_id": "200715", "simple": { "limit": 30, "period": 60 } }
      ],
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
