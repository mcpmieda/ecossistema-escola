{
  "name": "portal-aluno-demo-publica",
  "main": "workers/public-portal-demo/index.ts",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "node_modules/.cache/public-portal-demo",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "durable_objects": { "bindings": [{ "name": "DEMO_STATE", "class_name": "DemoState" }] },
  "migrations": [{ "tag": "public-demo-v1", "new_sqlite_classes": ["DemoState"] }],
  "vars": { "DEMO_ADMIN_TENANT_ID": "f04e0fa3-b8dc-4f77-be3c-7dfda0635188" },
  "observability": { "enabled": false },
  "limits": { "cpu_ms": 10 },
}
