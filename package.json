{
  "name": "ecossistema-escola",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.server.json && vite build",
    "test": "vitest run",
    "test:gradebook-readiness": "vitest run tests/gradebook/readiness",
    "gradebook:restore-rehearsal": "node --experimental-strip-types server/gradebook/recovery/run-logical-backup-recovery-v2.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.server.json --pretty false",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@azure/msal-browser": "5.19.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@vitejs/plugin-react": "latest",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "postgres": "3.4.9",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "vite": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/office-js": "^1.0.377",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
